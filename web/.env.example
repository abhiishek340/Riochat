# Dev proxy target for `pnpm dev` (rewrites /api/* to this origin).
RIOCHAT_BACKEND_URL=http://127.0.0.1:8080

# Optional: call an API on a different origin instead of the page's own origin.
# Leave unset when the backend hosts the exported site or the dev proxy is used.
# NEXT_PUBLIC_API_BASE_URL=https://chat.example.com
