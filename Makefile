# Developer entry point. Run `make` for the list of targets.

SHELL := /bin/bash
.DEFAULT_GOAL := help

PNPM       ?= pnpm
NODE       ?= node
# Backend configuration used by `make api`. Copy deploy/config.example.yaml to
# this path first and edit it.
API_CONFIG ?= $(CURDIR)/deploy/config.yaml

.PHONY: help setup dev api web desktop build build-api build-web build-desktop \
        release-desktop check test verify lint fmt api-docs version version-check clean

##@ Setup

setup: ## Install JS dependencies and fetch Go modules
	$(PNPM) install
	cd backend && go mod download

##@ Develop

dev: ## Start the API and the web dev server together
	@$(MAKE) --no-print-directory -j2 api web

api: ## Start the Go API (reads deploy/config.yaml)
	@if [ ! -f "$(API_CONFIG)" ]; then \
	  echo "No backend config at $(API_CONFIG)."; \
	  echo "Create it with: cp deploy/config.example.yaml deploy/config.yaml"; \
	  echo "Then edit it. Without PostgreSQL and Redis set database.driver: sqlite and cache.driver: memory."; \
	  exit 1; \
	fi
	CONFIG_FILE="$(API_CONFIG)" $(MAKE) --no-print-directory -C backend run

web: ## Start the web dev server on port 3000
	$(PNPM) --filter @riochat/web dev

desktop: ## Start the desktop app in development mode (separate identifier and data)
	$(PNPM) --filter @riochat/desktop dev

##@ Build

build: ## Build all workspaces (cached)
	$(PNPM) build

build-api: ## Build the Go server into .cache/riochat/
	$(NODE) scripts/build-api.mjs

build-web: ## Produce the static web export in web/out
	$(PNPM) --filter @riochat/web build

build-desktop: ## Fast local desktop build (app bundle only, light LTO)
	$(PNPM) --filter @riochat/desktop bundle:fast

release-desktop: ## Full desktop release build (signed when deploy/secrets/desktop-signing.env exists)
	$(NODE) scripts/sync-version.mjs --check
	$(PNPM) --filter @riochat/web build
	@if [ -f deploy/secrets/desktop-signing.env ]; then \
	  RIOCHAT_REFRESH_CATALOG_SNAPSHOTS=$${RIOCHAT_REFRESH_CATALOG_SNAPSHOTS:-1} $(PNPM) --filter @riochat/desktop bundle:signed; \
	else \
	  echo "note: deploy/secrets/desktop-signing.env not found; building without release signing" >&2; \
	  $(PNPM) --filter @riochat/desktop bundle; \
	fi

##@ Quality

check: ## Lint and type-check all workspaces
	$(PNPM) check

test: ## Run tests in all workspaces
	$(PNPM) test
	$(NODE) --test scripts/sync-version.test.mjs scripts/build-api.test.mjs

verify: ## check, then test, then build (the full local gate; CI runs the same steps per area)
	$(MAKE) --no-print-directory check
	$(MAKE) --no-print-directory test
	$(MAKE) --no-print-directory build

lint: ## Backend lint, then JS lint in parallel
	$(MAKE) --no-print-directory -C backend lint
	$(PNPM) -r --parallel --if-present lint

fmt: ## Format Go and auto-fix JS lint
	$(MAKE) --no-print-directory -C backend fmt
	$(PNPM) -r --if-present lint:fix

##@ Maintenance

api-docs: ## Regenerate API docs and the TS contract (not generated by this backend yet)
	@echo "The backend does not generate Swagger docs or a TypeScript contract yet (see GAPS.md); nothing to do."

version: ## Propagate VERSION to every manifest
	$(NODE) scripts/sync-version.mjs

version-check: ## Fail when a manifest differs from VERSION
	$(NODE) scripts/sync-version.mjs --check

clean: ## Remove build outputs
	$(NODE) scripts/clean.mjs

# `make help` prints every target documented with `## text`, grouped by the
# `##@ Group` headings.
help: ## Show this list
	@awk 'BEGIN {FS = ":.*## "; printf "\nUsage: make \033[36m<target>\033[0m\n"} \
	  /^##@/ {printf "\n\033[1m%s\033[0m\n", substr($$0, 5); next} \
	  /^[a-zA-Z0-9_-]+:.*## / {printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)
	@echo
