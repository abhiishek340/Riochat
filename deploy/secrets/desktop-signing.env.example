# Local desktop signing settings. Copy to desktop-signing.env (git-ignored),
# fill in the values and run `make release-desktop`.
# Paths are relative to the repository root or absolute. Never commit the copy.

# Updater key pair (required for any build that publishes updates).
TAURI_SIGNING_PRIVATE_KEY_PATH=deploy/secrets/updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS: Developer ID certificate (.p12) and notarization credentials.
# Either set all of these or none; a partial set makes the build fail.
APPLE_CERTIFICATE_PATH=deploy/secrets/developer-id.p12
APPLE_CERTIFICATE_PASSWORD=
APPLE_ID=
APPLE_PASSWORD=

# Optional remote sign-and-notarize service. It is used only when all four
# values are set.
SIGN_AND_NOTARIZE_SCRIPT_URL=
SIGN_AND_NOTARIZE_BASE_URL=
SIGN_AND_NOTARIZE_API_TOKEN=
SIGN_AND_NOTARIZE_HELPER_URL=

# Windows: code-signing certificate (.pfx).
WINDOWS_CERTIFICATE_PATH=
WINDOWS_CERTIFICATE_PASSWORD=
