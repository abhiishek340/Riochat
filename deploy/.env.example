# Optional overrides for docker-compose.full.yml. Copy to deploy/.env (git-ignored)
# and run compose from the deploy directory or with --env-file deploy/.env.
# Letters and digits only.

# Image to run. Build locally with: docker build -t riochat:local .
# RIOCHAT_CHAT_IMAGE=riochat:local

# Demo defaults are used when these are unset. Replace them for real use.
# RIOCHAT_POSTGRES_PASSWORD=
# RIOCHAT_REDIS_PASSWORD=
